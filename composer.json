{
    "name": "v3sp/v3cache",
    "description": "Monitoring, health checking, warmup and optimization for PHP OPcache",
    "type": "library",
    "license": "MIT",
    "keywords": ["opcache", "monitoring", "health-check", "cache", "performance"],
    "require": {
        "php": "^8.3.36",
        "ext-json": "*",
        "ext-zend-opcache": "*",
        "predis/predis": "^3.7"
    },
    "require-dev": {
        "cyclonedx/cyclonedx-php-composer": "^6.2",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10.0",
        "roave/security-advisories": "dev-latest",
        "squizlabs/php_codesniffer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "V3Cache\\OpcacheManager\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "V3Cache\\OpcacheManager\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/opcache-manager"
    ],
    "config": {
        "allow-plugins": {
            "cyclonedx/cyclonedx-php-composer": true
        },
        "audit": {
            "abandoned": "fail"
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
